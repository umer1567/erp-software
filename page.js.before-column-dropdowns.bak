                                                                    disabled={
                                                                        isReadOnly
                                                                    }
                                                                    value={
                                                                        item.tax_code ||
                                                                        ""
                                                                    }
                                                                    onChange={(
                                                                        event
                                                                    ) =>
                                                                        updateLine(
                                                                            index,
                                                                            "tax_code",
                                                                            event
                                                                                .target
                                                                                .value
                                                                        )
