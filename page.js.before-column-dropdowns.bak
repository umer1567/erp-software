                                                                    disabled={
                                                                        isReadOnly
                                                                    }
                                                                    value={
                                                                        item.item_name ||
                                                                        ""
                                                                    }
                                                                    onChange={(
                                                                        event
                                                                    ) =>
                                                                        updateLine(
