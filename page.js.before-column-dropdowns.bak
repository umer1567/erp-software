                                                                    type="number"
                                                                    min="0"
                                                                    max="100"
                                                                    step="0.001"
                                                                    disabled={
                                                                        isReadOnly
                                                                    }
                                                                    value={
                                                                        item.discount_percent ??
                                                                        0
                                                                    }
                                                                    onChange={(
                                                                        event
                                                                    ) =>
                                                                        updateLine(
                                                                            index,
                                                                            "discount_percent",
                                                                            event
                                                                                .target
                                                                                .value
