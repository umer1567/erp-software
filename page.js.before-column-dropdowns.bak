                                                                    disabled={
                                                                        isReadOnly
                                                                    }
                                                                    value={
                                                                        item.tax_rate ??
                                                                        0
                                                                    }
                                                                    onChange={(
                                                                        event
                                                                    ) =>
                                                                        updateLine(
                                                                            index,
