                                </Field>

                                <Field label="Department">
                                    <input
                                        className={inputClass}
                                        disabled={isReadOnly}
                                        value={form.department || ""}
                                        onChange={(event) =>
                                            updateForm(
                                                "department",
                                                event.target.value
                                            )
                                        }
                                        placeholder="Department"
                                    />
                                </Field>

                                <Field label="Sales Rep">
