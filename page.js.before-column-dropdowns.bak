                                                event.target.value
                                            )
                                        }
                                        placeholder="Class"
                                    />
                                </Field>

                                <Field label="Payment Terms">
                                    <input
                                        className={inputClass}
                                        disabled={isReadOnly}
                                        value={form.payment_term || ""}
                                        onChange={(event) =>
                                            updateForm(
                                                "payment_term",
                                                event.target.value
                                            )
                                        }
                                        placeholder="e.g. 60 DAYS"
                                    />
                                </Field>

                                <Field label="Currency">
                                    <select
                                        className={inputClass}
                                        disabled={isReadOnly}
                                        value={form.currency || "PKR"}
                                        onChange={(event) =>
                                            updateForm(
                                                "currency",
                                                event.target.value
                                            )
                                        }
                                    >
                                        <option value="PKR">
                                            Rupees (PKR)
                                        </option>
                                        <option value="USD">
                                            US Dollar (USD)
                                        </option>
                                        <option value="AED">
                                            UAE Dirham (AED)
                                        </option>
                                        <option value="SAR">
                                            Saudi Riyal (SAR)
                                        </option>
                                        <option value="GBP">
                                            British Pound (GBP)
                                        </option>
                                        <option value="EUR">
                                            Euro (EUR)
                                        </option>
                                    </select>
                                </Field>

                                <Field label="Exchange Rate">
                                    <input
                                        className={inputClass}
                                        type="number"
                                        min="0.000001"
                                        step="0.000001"
                                        disabled={isReadOnly}
                                        value={form.exchange_rate ?? 1}
                                        onChange={(event) =>
                                            updateForm(
                                                "exchange_rate",
                                                event.target.value
                                            )
                                        }
                                    />
                                </Field>

                                <Field label="Customer Credit Limit">
                                    <input
                                        className={`${inputClass} bg-slate-100 dark:bg-slate-800`}
                                        readOnly
                                        value={money(
                                            form.customer_credit_limit,
                                            currency
                                        )}
                                    />
                                </Field>

                                <Field label="Customer Balance">
                                    <input
                                        className={`${inputClass} bg-slate-100 dark:bg-slate-800`}
                                        readOnly
                                        value={money(
