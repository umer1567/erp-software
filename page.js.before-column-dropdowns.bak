                                        onChange={(event) =>
                                            updateForm(
                                                "sales_rep",
                                                event.target.value
                                            )
                                        }
                                        placeholder="Sales representative"
                                    />
                                </Field>

                                <Field label="Class">
                                    <input
                                        className={inputClass}
                                        disabled={isReadOnly}
