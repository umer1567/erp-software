                                            ) -
                                                Number(
                                                    form.customer_balance || 0
                                                ),
                                            currency
                                        )}
                                    />
                                </Field>

                                <Field
                                    label="Memo"
                                    className="sm:col-span-2 xl:col-span-4"
                                >
                                    <textarea
