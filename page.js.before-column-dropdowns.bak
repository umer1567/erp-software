                                                                />
                                                            </td>

                                                            <td className="min-w-[100px] px-2 py-2">
                                                                <input
                                                                    className={inputClass}
                                                                    type="number"
                                                                    disabled={
                                                                        isReadOnly
                                                                    }
                                                                    value={
                                                                        item.item_balance ??
                                                                        0
                                                                    }
                                                                    onChange={(
                                                                        event
                                                                    ) =>
                                                                        updateLine(
                                                                            index,
                                                                            "item_balance",
                                                                            event
                                                                                .target
                                                                                .value
