                                            currency
                                        )}
                                    />
                                </Field>

                                <Field label="Available Credit Limit">
                                    <input
                                        className={`${inputClass} bg-slate-100 dark:bg-slate-800`}
                                        readOnly
                                        value={money(
                                            Number(
