                                                                            index,
                                                                            "uom",
                                                                            event
                                                                                .target
                                                                                .value
                                                                        )
                                                                    }
                                                                />
                                                            </td>

                                                            <td className="min-w-[100px] px-2 py-2">
                                                                <input
