                                                    <th className="px-3 py-3">
                                                        Retail Price
                                                    </th>
                                                    <th className="px-3 py-3">
                                                        Discount %
                                                    </th>
                                                    <th className="px-3 py-3">
                                                        Unit Price
                                                    </th>
                                                    <th className="px-3 py-3">
                                                        Amount
                                                    </th>
                                                    <th className="px-3 py-3">
                                                        Tax Code
                                                    </th>
                                                    <th className="px-3 py-3">
                                                        Tax %
                                                    </th>
                                                    <th className="px-3 py-3">
                                                        Tax Amount
                                                    </th>
                                                    <th className="px-3 py-3">
                                                        Gross Amount
                                                    </th>
                                                    <th className="px-3 py-3">
                                                        Memo
                                                    </th>
                                                    {!isReadOnly ? (
                                                        <th className="px-3 py-3">
                                                            Action
                                                        </th>
                                                    ) : null}
                                                </tr>
                                            </thead>

                                            <tbody className="divide-y divide-slate-100 dark:divide-slate-800">
                                                {form.items.map(
                                                    (item, index) => (
                                                        <tr
                                                            key={index}
                                                            className="align-top"
                                                        >
                                                            <td className="px-3 py-3 font-bold">
                                                                {index + 1}
                                                            </td>

                                                            <td className="min-w-[190px] px-2 py-2">
                                                                <select
                                                                    className={inputClass}
                                                                    disabled={
                                                                        isReadOnly
                                                                    }
                                                                    value={
                                                                        item.product_id ||
                                                                        ""
                                                                    }
                                                                    onChange={(
                                                                        event
                                                                    ) =>
                                                                        updateLine(
                                                                            index,
                                                                            "product_id",
                                                                            event
                                                                                .target
                                                                                .value
                                                                        )
                                                                    }
                                                                >
                                                                    <option value="">
                                                                        Custom
                                                                        item /
                                                                        select
                                                                        product
