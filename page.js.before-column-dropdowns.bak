                                                                        0
                                                                    }
                                                                    onChange={(
                                                                        event
                                                                    ) =>
                                                                        updateLine(
                                                                            index,
                                                                            "retail_price",
                                                                            event
                                                                                .target
                                                                                .value
                                                                        )
                                                                    }
                                                                />
