                                                                {Number(
                                                                    item.gross_amount ||
                                                                        0
                                                                ).toFixed(2)}
                                                            </td>

                                                            <td className="min-w-[140px] px-2 py-2">
                                                                <input
                                                                    className={inputClass}
                                                                    disabled={
                                                                        isReadOnly
                                                                    }
                                                                    value={
                                                                        item.memo ||
                                                                        ""
                                                                    }
                                                                    onChange={(
                                                                        event
                                                                    ) =>
                                                                        updateLine(
                                                                            index,
                                                                            "memo",
                                                                            event
                                                                                .target
                                                                                .value
                                                                        )
                                                                    }
                                                                />
                                                            </td>

                                                            {!isReadOnly ? (
                                                                <td className="px-2 py-3">
                                                                    <button
                                                                        className="rounded-lg px-2 py-1 text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950"
                                                                        onClick={() =>
                                                                            removeLine(
                                                                                index
                                                                            )
                                                                        }
                                                                        title="Remove line"
                                                                    >
                                                                        Remove
                                                                    </button>
                                                                </td>
                                                            ) : null}
                                                        </tr>
                                                    )
                                                )}
                                            </tbody>
                                        </table>
                                    </div>

                                    <div className="mt-5 flex flex-wrap items-start justify-between gap-5">
                                        <div className="max-w-xl text-xs leading-5 text-slate-500 dark:text-slate-400">
                                            Saving a Sales Order records the
                                            order and its lines only. It does
                                            not deduct inventory or create
                                            accounting journals.
                                        </div>

                                        <div className="w-full max-w-sm rounded-xl bg-slate-50 p-4 dark:bg-slate-900">
                                            <div className="flex justify-between py-2 text-sm">
                                                <span className="text-slate-500">
                                                    Total Amount
                                                </span>

                                                <strong>
                                                    {money(
                                                        totals.subtotal,
                                                        currency
                                                    )}
                                                </strong>
                                            </div>

                                            <div className="flex justify-between py-2 text-sm">
                                                <span className="text-slate-500">
                                                    Tax Amount
                                                </span>

                                                <strong>
                                                    {money(
                                                        totals.taxAmount,
                                                        currency
                                                    )}
                                                </strong>
                                            </div>

                                            <div className="mt-2 flex justify-between border-t border-slate-200 pt-3 text-base dark:border-slate-700">
                                                <span className="font-bold">
                                                    Gross Amount
                                                </span>

                                                <strong className="text-emerald-700 dark:text-emerald-400">
                                                    {money(
                                                        totals.grossAmount,
                                                        currency
                                                    )}
                                                </strong>
                                            </div>
                                        </div>
                                    </div>
                                </>
                            ) : null}

                            {/* ACCOUNTING */}

                            {activeTab === "accounting" ? (
                                <div className="rounded-xl border border-dashed border-slate-300 p-8 text-center dark:border-slate-700">
                                    <h4 className="font-bold">
                                        Accounting Lines
                                    </h4>

                                    <p className="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                        Sales Orders do not post accounting
                                        entries. Accounting entries should be
                                        generated by your configured invoicing
                                        workflow.
                                    </p>
                                </div>
                            ) : null}

                            {/* RELATED TRANSACTIONS */}

                            {activeTab === "related" ? (
                                <div className="space-y-3">
                                    <div className="rounded-xl bg-slate-50 p-4 dark:bg-slate-900">
                                        <p className="text-xs font-bold uppercase text-slate-500">
                                            Created From
                                        </p>

                                        <p className="mt-1 font-semibold">
                                            {form.source_quotation_number ||
                                                (form.source_quotation_id
                                                    ? `Quotation ID ${form.source_quotation_id}`
                                                    : "Direct Sales Order")}
                                        </p>
                                    </div>

                                    <div className="rounded-xl bg-slate-50 p-4 dark:bg-slate-900">
                                        <p className="text-xs font-bold uppercase text-slate-500">
                                            Document Status
                                        </p>

                                        <p className="mt-1 font-semibold">
                                            {form.document_status ||
                                                "Pending Delivery Challan"}
                                        </p>
                                    </div>

                                    {form.order_id &&
                                    form.status === "APPROVED" ? (
                                        <Button
                                            variant="success"
                                            onClick={() =>
                                                notifyError(
                                                    "Delivery Challan creation has not been implemented yet. The order has not been changed."
                                                )
                                            }
                                        >
                                            Create Delivery Challan
                                        </Button>
                                    ) : null}
                                </div>
                            ) : null}

                            {/* SYSTEM INFORMATION */}

                            {activeTab === "system" ? (
                                <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                                    <Field label="Internal Order ID">
                                        <input
                                            className={inputClass}
                                            readOnly
                                            value={
                                                form.order_id ||
                                                "Assigned when saved"
                                            }
                                        />
                                    </Field>

                                    <Field label="Created At">
                                        <input
                                            className={inputClass}
                                            readOnly
                                            value={
                                                form.created_at
                                                    ? new Date(
                                                          form.created_at
                                                      ).toLocaleString()
                                                    : "Assigned when saved"
                                            }
                                        />
                                    </Field>

                                    <Field label="Updated At">
                                        <input
                                            className={inputClass}
                                            readOnly
                                            value={
                                                form.updated_at
                                                    ? new Date(
                                                          form.updated_at
                                                      ).toLocaleString()
                                                    : "—"
                                            }
                                        />
                                    </Field>

                                    <Field label="Created From">
                                        <input
                                            className={inputClass}
                                            readOnly
                                            value={
                                                form.source_quotation_number ||
                                                (form.source_quotation_id
                                                    ? `Quotation ${form.source_quotation_id}`
                                                    : "Direct entry")
                                            }
                                        />
                                    </Field>
                                </div>
                            ) : null}

                            {/* ATTACHMENTS */}

                            {activeTab === "attachments" ? (
                                <div className="space-y-3">
                                    <p className="text-sm text-slate-500 dark:text-slate-400">
                                        Attachment storage has not been wired
                                        to this page yet.
                                    </p>

                                    {form.attachment_url ? (
                                        <a
                                            href={form.attachment_url}
                                            target="_blank"
                                            rel="noreferrer"
                                            className="font-semibold text-blue-600 underline"
                                        >
                                            {form.attachment_name ||
                                                "Open attachment"}
                                        </a>
                                    ) : (
                                        <p className="text-sm">
                                            No attachment saved.
                                        </p>
                                    )}
                                </div>
                            ) : null}

                            {/* TERMS AND CONDITIONS */}

                            {activeTab === "terms" ? (
                                <Field label="Terms & Conditions">
                                    <textarea
                                        className={inputClass}
                                        rows={7}
                                        disabled={isReadOnly}
                                        value={form.terms_conditions || ""}
                                        onChange={(event) =>
                                            updateForm(
                                                "terms_conditions",
                                                event.target.value
                                            )
                                        }
                                        placeholder="Enter the terms and conditions for this Sales Order…"
                                    />
                                </Field>
                            ) : null}
                        </Section>

                        {/* FORM FOOTER */}

                        <div className="flex flex-wrap justify-end gap-2 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950">
                            {mode === "edit" ? (
                                <Button
                                    variant="primary"
                                    onClick={saveOrder}
                                    disabled={
                                        saving ||
                                        (form.order_id
                                            ? !permissions.canUpdate
                                            : !permissions.canCreate)
                                    }
                                >
                                    {saving
                                        ? "Saving…"
                                        : "Save Sales Order"}
                                </Button>
                            ) : permissions.canUpdate ? (
                                <Button
                                    variant="primary"
                                    onClick={() => setMode("edit")}
                                >
                                    Edit Sales Order
                                </Button>
                            ) : null}

                            <Button onClick={() => printReport()}>
                                Report / Print / Save PDF
                            </Button>

                            <Button onClick={goBack}>
                                Back to History
                            </Button>
                        </div>
                    </>
                ) : null}
            </div>
        </main>
    );
}